# Native projects are regenerated by Expo during EAS builds.
ios/
android/

# No GGUF is bundled any more. withNoCompressGguf deletes the models directory
# during prebuild and only copies the RAG embeddings, the catalogue ships five
# downloadable models with none preinstalled, and the build profile sets
# BUNDLED_LOCAL_MODEL_INCLUDED=false. Re-including gemma-3-1b here uploaded
# 769 MB to EAS on every build for a file the build then threw away.
assets/models/*.gguf
apps/wallet-mobile/assets/models/*.gguf

