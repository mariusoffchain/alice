    "check:release-version": "node scripts/check-release-version.mjs",
    "check:npm-audit": "node scripts/check-npm-audit.mjs"
  },
  "overrides": {
    "@expo/cli": {
      "tar": "7.5.22"
    },
    "miniflare": {
      "undici": "7.30.0",
      "sharp": "0.35.5"
    },
    "next": {
      "postcss": "8.5.28",
      "sharp": "0.35.5"
    },
    "onnxruntime-node": {
      "adm-zip": "0.6.1"
    },
    "@huggingface/transformers": {
      "sharp": "0.35.5"
    },
    "postcss": "8.5.28",
    "ws@>=8 <9": "8.22.0",
    "viem": {
      "ws": "8.22.0"
    },
    "metro": "0.83.8",
    "metro-babel-transformer": "0.83.8",
