# Stable placeholder bindings for `wrangler types`. These values are never used
# by `wrangler deploy`; they only make generated secret names deterministic in CI.
ADMIN_CONSOLE_ENABLED=false
AUTH_HMAC_KEY=typecheck-placeholder
VENICE_API_KEY=typecheck-placeholder
ADMIN_ALLOWED_USERNAMES=typecheck-placeholder
TEST_WALLET_FAUCET_XPUB=typecheck-placeholder
