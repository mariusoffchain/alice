{
  "expo": {
    "name": "Alice",
    "slug": "alicebtc",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0a",
    "splash": {
      "image": "./assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "media.offchain.wallet"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "media.offchain.wallet",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "scheme": "alice-wallet",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/withNoCompressGguf",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Alice to use Face ID to unlock your wallet."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Alice to scan Arkade and Bitcoin payment QR codes."
        }
      ],
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "compileSdkVersion": 35
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ae7e0df8-efc3-4beb-9fd8-8c0d542220c1"
      }
    },
    "owner": "alicebitcoin"
  }
}
