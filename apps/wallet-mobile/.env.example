# Route Private Cloud through Alice's blind proxy. This is required in every
# distributed build: an APK can be inspected, so it must not contain Venice's
# production API key.
EXPO_PUBLIC_VENICE_PROXY_URL=
EXPO_PUBLIC_PRIVATE_CLOUD_ENABLED=true

# Optional DCAP collateral endpoint. Leave empty to use the proxy's /pccs path
# when a proxy is configured, or Phala's public PCCS in direct mobile mode.
EXPO_PUBLIC_VENICE_PCCS_URL=

# Mutinynet swap provider. Use Satora for current Lightning send/receive tests.
EXPO_PUBLIC_SWAP_PROVIDER=satora
EXPO_PUBLIC_SATORA_URL=https://mutinynetswap.lendasat.com

# --- Bitcoin mainnet ---
# network-config.ts refuses to start on mainnet without an explicit ASP and
# Esplora, rather than silently falling back to Mutinynet endpoints. That guard
# is deliberate: keep these values here so a mainnet build never has to guess
# them. The EAS `production` profile carries the same set.
# EXPO_PUBLIC_NETWORK=bitcoin
# EXPO_PUBLIC_ASP_URL=https://arkade.computer
# EXPO_PUBLIC_ESPLORA_URL=https://mempool.space/api
# EXPO_PUBLIC_SWAP_PROVIDER=satora
# EXPO_PUBLIC_SATORA_URL=https://api.satora.io
# EXPO_PUBLIC_ARKADE_EXPLORER=https://arkade.space

# Optional public build metadata shown in About.
# On Vercel, this can come from VERCEL_GIT_COMMIT_SHA automatically.
EXPO_PUBLIC_APP_COMMIT_SHA=

# Build version reported with Private Cloud requests, as x.y.z. Used only for
# the aggregate platform/version breakdown in the admin dashboard — anything
# malformed is simply not reported. See docs/security/admin-dashboard.md.
EXPO_PUBLIC_ALICE_APP_VERSION=0.2.0
