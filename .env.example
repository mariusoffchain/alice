# Network Configuration
# Determines which network Alice targets: 'mutinynet' (Bitcoin testnet) or 'bitcoin' (mainnet).
# Default: mutinynet
EXPO_PUBLIC_NETWORK=mutinynet

# Arkade Service Provider URL — the entrypoint for Ark operations
EXPO_PUBLIC_ASP_URL=https://mutinynet.arkade.sh

# Esplora (blockchain explorer) API URL for on-chain lookups
EXPO_PUBLIC_ESPLORA_URL=https://mutinynet.com/api

# Boltz (swap provider) API URL
EXPO_PUBLIC_BOLTZ_URL=https://api.boltz.mutinynet.arkade.sh

# Active swap provider for new Lightning sends/receives.
# Use satora for Mutinynet Satora validation. For bitcoin mainnet, keep this
# fail-closed until EXPO_PUBLIC_SATORA_URL points to an explicit mainnet server.
EXPO_PUBLIC_SWAP_PROVIDER=satora

# Satora API URL. Mutinynet has a known endpoint; mainnet must be explicit.
EXPO_PUBLIC_SATORA_URL=https://mutinynetswap.lendasat.com

# Optional Arkade virtual transaction explorer. Leave unset on mainnet until a
# trusted explorer has been selected; on-chain links still use Mempool.
# EXPO_PUBLIC_ARKADE_EXPLORER=

# Blind proxy URL for Private Cloud (Cloudflare Worker in apps/venice-proxy-worker).
# Required in every distributed build. The Worker holds the Venice API key; no
# client bundle, including an APK or desktop application, may contain it.
# Example: https://proxy.alicebtc.com
EXPO_PUBLIC_VENICE_PROXY_URL=
EXPO_PUBLIC_PRIVATE_CLOUD_ENABLED=true

# Direct Venice calls bypass Alice accounts and the 21-request quota. Keep this
# false or unset in every tester and production build. It exists only for
# explicit internal provider debugging with a personal, revocable key that must
# never be Alice's production key.
EXPO_PUBLIC_ALLOW_DIRECT_VENICE=false

# Optional DCAP collateral endpoint. For the Alice Worker use its /pccs path,
# e.g. https://alice-venice-proxy.example.workers.dev/pccs. If omitted while
# using the proxy, Alice derives this URL from EXPO_PUBLIC_VENICE_PROXY_URL.
EXPO_PUBLIC_VENICE_PCCS_URL=

# Build version reported with Private Cloud requests, as x.y.z. Used only for
# the aggregate platform/version breakdown in the admin dashboard — anything
# malformed is simply not reported. See docs/security/admin-dashboard.md.
EXPO_PUBLIC_ALICE_APP_VERSION=0.2.1

# Learn packs base. English ships inside the app; the 28 other course languages
# are fetched from the packs repository (Plan B Network corpus, CC BY-SA 4.0).
# Left unset, everything falls back to the local copy under public/learn, which
# is what dev uses. Pin the tag, and bump it when the corpus is regenerated.
NEXT_PUBLIC_LEARN_PACKS_BASE=https://cdn.jsdelivr.net/gh/mariusoffchain/alice-learn-planb-packs@v2

# Cloudflare Web Analytics token for the MARKETING SITE only (apps/site), never
# the app. Cookieless page-view counts, no fingerprint, no cross-site tracking;
# what it collects is described on the site's /privacy page, which must stay in
# agreement with this setting. Left unset (dev, forks), no beacon is loaded at
# all. The token is not a secret: it travels in the page's own HTML.
# NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
